{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "practica-canciones",
  "version": "0.1.0",
  "identifier": "com.fantaxmin.practicacanciones",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Práctica de canciones",
        "width": 1200,
        "height": 800,
        "minWidth": 380
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "rpm",
      "deb",
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Práctica de canciones",
    "longDescription": "Organiza tu repertorio, genera setlists y calienta con escalas y entrenamiento de oído.",
    "category": "Music"
  }
}
